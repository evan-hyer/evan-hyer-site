{
  "name": "evan-hyer-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "slices/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/services.mjs dev",
    "dev:shell": "node scripts/services.mjs dev shell",
    "dev:profile": "node scripts/services.mjs dev profile",
    "dev:projects": "node scripts/services.mjs dev projects",
    "dev:insights": "node scripts/services.mjs dev insights",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/services.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/bff.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:preview": "node scripts/test-preview.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:profile:web": "node scripts/services.mjs dev profile web",
    "dev:profile:bff": "node --import tsx slices/profile/bff/index.ts",
    "dev:projects:web": "node scripts/services.mjs dev projects web",
    "dev:projects:bff": "node --import tsx slices/projects/bff/index.ts",
    "dev:insights:web": "node scripts/services.mjs dev insights web",
    "dev:insights:bff": "node --import tsx slices/insights/bff/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@module-federation/enhanced": "2.9.0",
    "@playwright/test": "1.63.0",
    "@rspack/cli": "2.2.6",
    "@rspack/core": "2.2.6",
    "@rspack/dev-server": "2.2.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "css-loader": "7.1.5",
    "postcss": "8.5.28",
    "postcss-loader": "8.2.1",
    "prettier": "3.9.8",
    "style-loader": "4.0.0",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
